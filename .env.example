# Copy this file to .env and fill in real values. Never commit .env.

# Ports
# 5000 = new StudioSpace client (studiospace-client)
# 8000 = optional legacy frontend compatibility listener
PORT=5000
LEGACY_PORT=8000
NODE_ENV=development

# MongoDB connection string (database name defaults to "studiospace")
MONGO_DB_SERVER=mongodb://127.0.0.1:27017
# MONGO_DB_NAME=studiospace

# Better Auth (Next.js app) base URL
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated browser origins allowed to call this API
CLIENT_URL=http://localhost:3000,http://localhost:3001

# Required. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
